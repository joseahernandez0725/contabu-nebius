# Plantilla de variables de entorno del backend de ContaBu.
# Copia este archivo a `.env` y reemplaza TU_CONTRASEÑA por la contraseña real
# que pusiste al crear el usuario de PostgreSQL.
#
# IMPORTANTE: `.env` NO se sube a git (está en .gitignore). Este `.env.example` SÍ,
# pero sin secretos reales.

DATABASE_URL=postgresql+psycopg://contabu:TU_CONTRASEÑA@localhost:5432/contabu

# ===== IA: Nemotron en Nebius Token Factory (toda la IA de ContaBu, desde el 13-oct) =====
NEBIUS_API_KEY=                # https://tokenfactory.nebius.com → API keys
# NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B     # opcional (este es el de por defecto)
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/  # opcional (este es el de por defecto)

# ===== ② Verificador de comercios (Tavily) =====
TAVILY_API_KEY=                # https://app.tavily.com → API keys (sin ella, el resto de la app funciona)

# Modelo y razonamiento POR AGENTE (opcionales; ver backend/agent_models.py; abajo, los de por defecto). nano | lightning | super | ultra
# ① revisor
# AGENT_MODEL_REVIEWER=nano
# AGENT_REASONING_REVIEWER=0
# ④ redactor
# AGENT_MODEL_DRAFTER=super
# AGENT_REASONING_DRAFTER=1
# ⑤ ¿personal para este negocio?
# AGENT_MODEL_PERSONAL=nano
# AGENT_REASONING_PERSONAL=0
# traductor de notas
# AGENT_MODEL_NOTES=super
# AGENT_REASONING_NOTES=0

# Topes por oficina en 24 h (opcionales; por defecto 200 llamadas y 100 búsquedas, en el demo 20 y 15)
# AGENT_DAILY_CALLS=200
# AGENT_DAILY_SEARCHES=100

# ===== Bancos vinculados (Plaid) =====
PLAID_CLIENT_ID=               # del Dashboard de Plaid (Developers → Keys)
PLAID_SECRET=                  # el secret es POR AMBIENTE: el de sandbox no sirve en production
PLAID_ENV=sandbox              # sandbox | production
BANK_TOKEN_KEY=                # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
