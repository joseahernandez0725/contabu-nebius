# Plantilla de variables de entorno del backend de ContaBu.
# Copia este archivo a `.env` y reemplaza TU_CONTRASEÑA por la contraseña real
# que pusiste al crear el usuario de PostgreSQL.
#
# IMPORTANTE: `.env` NO se sube a git (está en .gitignore). Este `.env.example` SÍ,
# pero sin secretos reales.

DATABASE_URL=postgresql+psycopg://contabu:TU_CONTRASEÑA@localhost:5432/contabu

# API key de Gemini — sácala en https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_api_key_de_gemini

# ===== Bancos vinculados (Plaid) =====
PLAID_CLIENT_ID=               # del Dashboard de Plaid (Developers → Keys)
PLAID_SECRET=                  # el secret es POR AMBIENTE: el de sandbox no sirve en production
PLAID_ENV=sandbox              # sandbox | production
BANK_TOKEN_KEY=                # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
