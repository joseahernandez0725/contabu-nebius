# ContaBu backend environment template.
# Copy this file to `.env` and replace YOUR_PASSWORD with the password you set
# when you created the PostgreSQL user.
#
# IMPORTANT: `.env` is NOT committed to git (it is in .gitignore). This `.env.example` is,
# but without real secrets.

DATABASE_URL=postgresql+psycopg://contabu:YOUR_PASSWORD@localhost:5432/contabu

# ===== AI: Nemotron on Nebius Token Factory (all of ContaBu's AI) =====
NEBIUS_API_KEY=                # https://tokenfactory.nebius.com → API keys
# NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B     # optional (this is the default)
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/  # optional (this is the default)

# ===== ② Merchant verifier (Tavily) =====
TAVILY_API_KEY=                # https://app.tavily.com → API keys (without it, the rest of the app works)

# Model and reasoning PER AGENT (optional; see backend/agent_models.py; the defaults are below). nano | lightning | super | ultra | vl
# ① reviewer
# AGENT_MODEL_REVIEWER=nano
# AGENT_REASONING_REVIEWER=0
# ② verifier: the model that classifies the web results
# AGENT_MODEL_CLASSIFIER=super
# AGENT_REASONING_CLASSIFIER=0
# VERIFIER_CLASSIFIER=nemotron   # `table` turns the model off and uses only the keyword table
# ④ rule drafter
# AGENT_MODEL_DRAFTER=vl
# AGENT_REASONING_DRAFTER=0
# ⑤ personal for this business?
# AGENT_MODEL_PERSONAL=nano
# AGENT_REASONING_PERSONAL=0
# ⑥ note translator
# AGENT_MODEL_NOTES=super
# AGENT_REASONING_NOTES=0

# Per-office caps over 24 h (optional; by default 200 calls and 100 searches, 20 and 15 in the demo)
# AGENT_DAILY_CALLS=200
# AGENT_DAILY_SEARCHES=100

# ===== Linked banks (Plaid) =====
PLAID_CLIENT_ID=               # from the Plaid Dashboard (Developers → Keys)
PLAID_SECRET=                  # the secret is PER ENVIRONMENT: the sandbox one does not work in production
PLAID_ENV=sandbox              # sandbox | production
BANK_TOKEN_KEY=                # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
